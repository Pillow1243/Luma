# Supabase project (Settings → API)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: public URL of the deployed web app (used by the Capacitor shell)
VITE_APP_URL=https://luma-messenger-chi.vercel.app

# Optional: free Open Relay/Metered TURN account. Example credentials are not
# guaranteed to work; production should issue short-lived TURN credentials.
VITE_TURN_URLS=turn:openrelay.metered.ca:80,turn:openrelay.metered.ca:443?transport=tcp
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Optional: free GIPHY developer API key (built-in stickers need no key).
VITE_GIPHY_API_KEY=
