<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Luma talks to HTTPS only: the Vercel app and Supabase APIs. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
