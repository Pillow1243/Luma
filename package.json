{
  "name": "luma",
  "private": true,
  "version": "2.1.0",
  "description": "Luma — a premium, glassmorphic realtime messenger.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "tsc --noEmit",
    "cap:add": "cap add android",
    "cap:sync": "cap sync android",
    "cap:open": "cap open android",
    "jdk": "node scripts/fetch-jdk.mjs",
    "keystore": "node scripts/make-keystore.mjs",
    "icons": "python3 scripts/make-icons.py && python3 scripts/make-shell-res.py",
    "apk": "node scripts/build-apk.mjs",
    "release": "npm run build && npm run apk",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser:calls": "node tests/browser-calls.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@supabase/supabase-js": "^2.45.4",
    "date-fns": "^4.1.0",
    "framer-motion": "^11.11.9",
    "idb": "^8.0.4",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/cli": "^7.6.10",
    "@capacitor/core": "^7.6.10",
    "@drxiaozhi/minapk": "0.5.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "aaptjs3": "2.0.2",
    "autoprefixer": "^10.4.20",
    "fake-indexeddb": "^6.2.8",
    "playwright-core": "^1.65.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^6.4.6"
  }
}
